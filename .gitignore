# ---------------------------------------------------------------
#  构建产物（可重新生成，不进仓库）
# ---------------------------------------------------------------
.venv/
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/

app/.build/
app/dist/
app/DerivedData/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
.build/

# ---------------------------------------------------------------
#  出图产物
#
#  out/          旧 Python 管线的交付物
#  out_lpx*/     LightPlot 的交付物与过程截图
#
#  这些都能用 ./run.sh 或 ./app/run.sh 重生成。
#  需要成品的人去 Releases 下载，不需要把 PDF 塞进 git 历史。
# ---------------------------------------------------------------
out/
out_lpx/
out_lpx_evidence/
out_lpx_full/

# ---------------------------------------------------------------
#  GDTF 原始文件（约 8MB，可由 src/gdtf_fetch.py 重新下载）
# ---------------------------------------------------------------
data/gdtf/*.gdtf

# 从 GDTF 提取的符号缓存（可由 src/gdtf_symbol.py --build 重建）
data/symbols.json

# ★ data/golden.json 不要忽略 —— 它是黄金图回归基准，必须跟代码走。
#   丢了它，golden.py 只剩绝对阈值，"分数掉了 0.06" 这类漂移就检测不到。

# ---------------------------------------------------------------
#  版权限制：参考图册不进仓库
#
#  brief/reference/ 里是第三方 PDF（USITT RP-2、某真实制作的灯光图、
#  大学的制图标准）。这些不是本项目的版权，公开仓库不能分发。
#  自己本地保留即可。
# ---------------------------------------------------------------
brief/reference/

# ---------------------------------------------------------------
#  Agent 会话状态（含目标、MCP 配置与事件日志，与本项目无关）
# ---------------------------------------------------------------
.pi/

# ---------------------------------------------------------------
#  macOS
# ---------------------------------------------------------------
.DS_Store
**/.DS_Store
